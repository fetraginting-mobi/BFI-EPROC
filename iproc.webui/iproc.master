<%@ Master Language="C#" AutoEventWireup="true" CodeFile="iproc.master.cs" Inherits="iproc" %>
<%@ Register Src="wcmenu.ascx" TagName="wcmenu" TagPrefix="uc1" %>
<%@ Register Src="wcheader.ascx" TagName="wcheader" TagPrefix="uc2" %>

<!DOCTYPE html>
<html lang="en">
<head id="Head1" runat="server">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IProcurement</title>
    
    <link href="css/bootstrap.css" rel="stylesheet">
    <link href="css/bootstrap-reset.css" rel="stylesheet">
    
    <link href="assets/bootstrap-datepicker/css/datepicker.css" rel="stylesheet" />
    <link href="assets/font-awesome/css/font-awesome-ie7.css" rel="stylesheet" />
    <link href="assets/font-awesome/css/font-awesome-ie7.min.css" rel="stylesheet" />
    <link href="assets/font-awesome/css/font-awesome.css" rel="stylesheet" />
    <link href="assets/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="assets/flatpickr/css/flatpickr.min.css" rel="stylesheet" />
    
    <link href="css/style.css" rel="stylesheet">
    <link href="css/style-responsive.css" rel="stylesheet" />
    
    <asp:ContentPlaceHolder id="cph" runat="server">
    </asp:ContentPlaceHolder>
    
    <script src="../../js/jquery-1.8.3.min.js"></script>
    <script src="../../js/bootstrap.min.js"></script>
    <script class="include" type="text/javascript" src="../../js/jquery.dcjqaccordion.2.7.js"></script>
    <script src="../../js/jquery.scrollTo.min.js"></script>
    <script src="../../js/jquery.nicescroll.js" type="text/javascript"></script>
    <script src="../../js/respond.min.js"></script>
    <script src="../../js/checkbox.js"></script>
    
    <script src="../../assets/bootstrap-datepicker/js/bootstrap-datepicker.js"></script>
    <script src='<%=ResolveClientUrl("~/js/jquery.blockUI.js")%>' type="text/javascript"></script>
    <script src="../../assets/highcharts/js/highcharts.js"></script>
    <script src="../../assets/highcharts/js/modules/exporting.js"></script>
    <script src="../../assets/flatpickr/js/flatpickrv4.6.13.js"></script>

    <script src="../../js/accounting.min.js"></script>
    <script src="../../js/common-scripts.js"></script>
    <script src="../../js/hris.js"></script>
</head>
<body>
    <form id="form1" runat="server">
    <asp:ScriptManager ID="smMain" runat="server">
    </asp:ScriptManager>
   
    <asp:ContentPlaceHolder id="cpb" runat="server">
    </asp:ContentPlaceHolder>
      
    <script type="text/javascript">
        $('.default-date-picker').datepicker({
            ignoreReadonly: true,
            startDate:'now',
            maxDate: 'now',
            clearBtn: true,
            format: 'dd/mm/yyyy',
            daysOfWeekDisabled: "0",
            orientation: "top auto",
            todayHighlight: true
        }).on('changeDate', function(e) {
            $(this).datepicker('hide');
        });
        
        $('.default-date-picker-all').datepicker({
            ignoreReadonly: true,
            clearBtn: true,
            format: 'dd/mm/yyyy',
            orientation: "top auto",
            todayHighlight: true
        }).on('changeDate', function(e) {
            $(this).datepicker('hide');
        });

        $('.default-date-picker-ticket').datepicker({
            ignoreReadonly: true,
            clearBtn: true,
            format: 'dd/mm/yyyy',
            orientation: "top auto",
            todayHighlight: true
        }).on('changeDate', function(e) {
            $(this).datepicker('hide');
        });
      
        function datepicker() {
            $('.default-date-picker').datepicker({
                ignoreReadonly: true,
                startDate: 'now',
                maxDate: 'now',
                format: "dd/mm/yyyy",
                clearBtn: true,
                orientation: "top auto",
                forceParse:false
            }).on('changeDate', function(e) {
                $(this).datepicker('hide');
            });

            $('.default-date-picker-ticket').datepicker({
                ignoreReadonly: true,
                startDate: 'now',
                maxDate: 'now',
                clearBtn: true,
                format: 'dd/mm/yyyy',
                daysOfWeekDisabled: "0",
                orientation: "top auto",
                todayHighlight: true
            }).on('changeDate', function(e) {
                $(this).datepicker('hide');
            });

            $('.default-date-picker-all').datepicker({
                ignoreReadonly: true,
                clearBtn: true,
                format: 'dd/mm/yyyy',
                daysOfWeekDisabled: "0,6",
                orientation: "top auto",
                todayHighlight: true
            }).on('changeDate', function(e) {
                $(this).datepicker('hide');
            });
        }
      
        function hideTab() {
            $('.hidden-tab').each(
              function() {
                  var id = $(this).attr('href');
                  $(this).parent().attr('style', 'display:none');
                  $(''+id).attr('style', 'display:none');
              }
            );
        }
      
        $(document).ready(function() {
            if (typeof fnSetActiveTab === "function") { 
                fnSetActiveTab(); 
            }
        });
    </script>
    
    <script type="text/javascript">
        // Get the instance of PageRequestManager.
        var prm = Sys.WebForms.PageRequestManager.getInstance();

        // Add initializeRequest and endRequest
        prm.add_initializeRequest(prm_InitializeRequest);
        prm.add_endRequest(prm_EndRequest);

        // Called when async postback begins
        function prm_InitializeRequest(sender, args) {
            try {
                // Disable button that caused a postback
                $.blockUI({ css: {
                    border: 'none',
                    padding: '15px',
                    backgroundColor: '#000',
                    '-webkit-border-radius': '10px',
                    '-moz-border-radius': '10px',
                    opacity: .5,
                    color: '#fff'
                }
                });
            }
            catch (e) {
            }
        }

        // Called when async postback ends
        function prm_EndRequest(sender, args) {
            try {
                // Enable button that caused a postback
                $.unblockUI();
            }
            catch (e) {
            }
        }
    </script>
    
    <div class="modal fade" id="ModalPopup" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Lookup</h4>
                </div>
                <div class="modal-body">
                    <iframe id="ifrpopup" src="" frameborder="0" name="ifrpopup" width="100%" height="320px" scrolling="auto" style="background-color:#fff" allowtransparency="true"></iframe>
                </div>
                <div class="modal-footer">
                    <button data-dismiss="modal" class="btn btn-default" type="button">Close</button>
                </div>
            </div>
        </div>
    </div>
  
    <div class="modal fade" id="ErrorNotif" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Fail</h4>
                </div>
                <div class="modal-body">
                    <h4><i class="icon-thumbs-down-alt"></i> Oh no!!</h4>
                    <p id="ErrorMsg"></p>
                    
                    <div class="panel panel-default" id="PanelTechMsg" style="display:none">
                        <div class="panel-heading">
                            <h4 class="panel-title">
                                <a class="accordion-toggle" style="color:Red" data-toggle="collapse" data-parent="#accordion" href="#collapseOne">Technical Error </a>
                            </h4>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse">
                            <div class="panel-body">
                                <p id="ErrorTechMsg" style="color:Red"></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button data-dismiss="modal" class="btn btn-default" type="button">OK</button>
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="SuccessNotif" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Success</h4>
                </div>
                <div class="modal-body">
                    <h4><i class="icon-thumbs-up-alt"></i> Horayyy!</h4>
                    <p id="SuccessMsg"></p>
                </div>
                <div class="modal-footer">
                    <button data-dismiss="modal" class="btn btn-default" type="button">OK</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="ApprovalPassword" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog" style="width:400px">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Approval</h4>
                </div>
                <div class="modal-body">
                    <iframe id="ifrapproval" src="" frameborder="0" name="ifrapproval" width="100%" height="70px" scrolling="no" style="background-color:#fff" allowtransparency="true"></iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="ApprovalPasswordWithComment" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Approval</h4>
                </div>
                <div class="modal-body">
                    <iframe id="ifrapprovalWithComment" src="" frameborder="0" name="ifrapproval" width="100%" height="220px" scrolling="no" style="background-color:#fff" allowtransparency="true"></iframe>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="ApprovalTiered" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title">Approval</h4>
                </div>
                <div class="modal-body">
                    <iframe id="ifrapprovalTiered" src="" frameborder="0" name="ifrapproval" width="100%" height="580px" scrolling="no" style="background-color:#fff" allowtransparency="true"></iframe>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="GenericScreen" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog" style="width:88%;">
            <div class="modal-content">
                <div class="modal-body">
                    <iframe id="ifgenericscreen" src="" frameborder="0" name="ifgenericscreen" width="100%" height="640px" scrolling="no" style="background-color:#fff" allowtransparency="true"></iframe>
                </div>
            </div>
        </div>
    </div>
    </form>
</body>
</html>