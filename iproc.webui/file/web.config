<?xml version="1.0"?>
<configuration>
  <system.web>
    <httpHandlers>
      <clear />
      <add  path="*" verb="*" type="CustomHttpHandler" />
    </httpHandlers>
  </system.web>

  <system.webServer>

    <handlers>
      <clear />
      <add name="CustomHttpHandlerForpdf" verb="*" path="*" type="CustomHttpHandler"/>
      <!-- <add name="CustomHttpHandlerForzip" verb="*" path="*/file/*" type="CustomHttpHandler"/> -->
    </handlers>
  </system.webServer>
</configuration>